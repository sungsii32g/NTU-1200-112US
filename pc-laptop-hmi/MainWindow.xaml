<Window x:Class="Ntu1200Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ntu1200Hmi.ViewModels"
        mc:Ignorable="d"
        Title="MEAN WELL NTU-1200-112US 筆電 / 工控 PC 桌面監控中心"
        Width="1320" Height="900" MinWidth="1050" MinHeight="750"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextMain}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <!-- 系統原生 Boolean 到 Visibility 轉換器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 工業暗黑風卡片容器樣式 -->
        <Style x:Key="IndustrialCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- 扁平化按鈕樣式 -->
        <Style x:Key="IndustrialButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 高對比度下拉選單項目樣式 (徹底解決文字看不清問題) -->
        <Style x:Key="HighContrastComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162032" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0284C7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0EA5E9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 1. 頂部導航與通訊埠 -->
                <RowDefinition Height="Auto" /> <!-- 2. 雙模式分頁切換列 -->
                <RowDefinition Height="*" />    <!-- 3. 主內容視圖區 (監控 vs 工程) -->
                <RowDefinition Height="Auto" /> <!-- 4. 底部 ASCII 封包監視器 -->
            </Grid.RowDefinitions>

            <!-- 1. 頂部導航與串列埠選擇列 -->
            <Border Grid.Row="0" Style="{StaticResource IndustrialCard}" Padding="14,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌 LOGO -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCyan}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="MW" FontWeight="Bold" FontSize="14" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MEAN WELL NTU-1200-112US" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="正弦波逆變器 / UPS 工業控制中心" FontSize="11" Foreground="{StaticResource TextDim}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 串列埠控制欄位 (高對比高清晰配色) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="通訊埠 (PORT)：" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentCyan}" Margin="0,0,8,0" />
                        
                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  DisplayMemberPath="DisplayText"
                                  ItemContainerStyle="{StaticResource HighContrastComboItem}"
                                  Width="380" Height="36"
                                  Background="#1E293B" Foreground="#FFFFFF"
                                  BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.5"
                                  FontSize="13" FontWeight="Bold"
                                  VerticalContentAlignment="Center" Margin="0,0,10,0" />

                        <Button Content="{Binding ConnectButtonText}" 
                                Click="BtnConnect_Click"
                                Background="{StaticResource AccentCyan}"
                                Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />

                        <Button Content="⟳ 掃描" Click="BtnRefresh_Click"
                                Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                Style="{StaticResource IndustrialButton}" />
                    </StackPanel>

                    <!-- 狀態指示徽章 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="16" Padding="12,6" Margin="0,0,10,0" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <TextBlock Text="{Binding LatencyMs, StringFormat='延遲: {0} ms'}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 全系統統一：雙模式分頁切換按鈕 (監控模式 vs 工程應用模式) -->
            <Border Grid.Row="1" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 監控模式切換按鈕 -->
                    <RadioButton Grid.Column="0" Content="📊 即時監控模式 (Monitoring Mode)"
                                 IsChecked="{Binding IsMonitorMode, Mode=OneWay}"
                                 Click="BtnSwitchMonitor_Click"
                                 GroupName="UiMode"
                                 FontSize="13" FontWeight="Bold" Foreground="White"
                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"
                                 Cursor="Hand" />

                    <!-- 工程應用模式切換按鈕 -->
                    <RadioButton Grid.Column="1" Content="🛠️ 工程應用模式 (Engineering / Pro Mode)"
                                 IsChecked="{Binding IsEngineeringMode, Mode=OneWay}"
                                 Click="BtnSwitchEngineering_Click"
                                 GroupName="UiMode"
                                 FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentAmber}"
                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"
                                 Cursor="Hand" />
                </Grid>
            </Border>

            <!-- 3. 主內容區 -->
            <Grid Grid.Row="2">
                <!-- ==================== 視圖 A：即時監控模式 (Monitoring Mode) ==================== -->
                <StackPanel Visibility="{Binding IsMonitorMode, Converter={StaticResource BoolToVis}}">
                    <!-- 電力潮流即時動態拓撲 -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="⚡ 電力潮流即時動態拓撲 (Power Flow Topology)" FontWeight="SemiBold" FontSize="14" />
                                <Border DockPanel.Dock="Right" Background="#0F172A" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{Binding PowerPath}" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                </Border>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- 市電輸入節點 -->
                                <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🏢 市電輸入 (Grid)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding GridInputVoltage, StringFormat='{}{0:F1} V'}" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="White" />
                                        <TextBlock Text="{Binding OutputFrequency, StringFormat='頻率: {0:F1} Hz'}" FontSize="11" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="1" Text="────►" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource AccentCyan}" FontFamily="Consolas" FontSize="14" />

                                <!-- 中央逆變器核心 -->
                                <Border Grid.Column="2" Background="#111B2C" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2" CornerRadius="12" Padding="14">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="NTU-1200 逆變核心 / UPS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" />
                                        <TextBlock Text="{Binding PowerPath}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" Foreground="White" />
                                        <TextBlock Text="{Binding DcBusVoltage, StringFormat='內部直流高壓母線: {0:F1} V'}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="3" Text="────►" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource AccentCyan}" FontFamily="Consolas" FontSize="14" />

                                <!-- 交流輸出負載節點 -->
                                <Border Grid.Column="4" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="💡 交流負載 (Load)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding LoadWatts, StringFormat='{}{0:F0} W'}" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource AccentCyan}" />
                                        <TextBlock Text="{Binding LoadPercent, StringFormat='負載率: {0} % 額定'}" FontSize="11" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 四大核心數據儀表網格 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1：電池電壓 -->
                        <Border Grid.Column="0" Style="{StaticResource IndustrialCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="直流電池電壓" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBlock Text="{Binding BatteryStatusText}" DockPanel.Dock="Right" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                </DockPanel>
                                <TextBlock Text="{Binding BatteryVoltage, StringFormat='{}{0:F1} V'}" FontFamily="Consolas" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,10,0,4" />
                                <TextBlock Text="保護門檻: 10.0V 關斷 / 11.0V 預警 / 16.5V 過壓" FontSize="10" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2：交流輸出瓦數 -->
                        <Border Grid.Column="1" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="交流輸出 &amp; 負載率" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBlock Text="{Binding LoadPercent, StringFormat='{}{0}%'}" DockPanel.Dock="Right" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" />
                                </DockPanel>
                                <TextBlock Text="{Binding LoadWatts, StringFormat='{}{0:F0} W'}" FontFamily="Consolas" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,10,0,4" />
                                <TextBlock Text="{Binding AcOutputVoltage, StringFormat='電壓: {0:F1} V (額定 1200W)'}" FontSize="10" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 3：散熱器溫度 -->
                        <Border Grid.Column="2" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="機內散熱器溫度" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBlock Text="正常" DockPanel.Dock="Right" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                </DockPanel>
                                <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F1} °C'}" FontFamily="Consolas" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,10,0,4" />
                                <TextBlock Text="風扇啟動: ≥ 50°C | 過溫保護: 75°C" FontSize="10" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 4：運作旗標 -->
                        <Border Grid.Column="3" Style="{StaticResource IndustrialCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="硬體狀態旗標" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Rows="3">
                                    <CheckBox Content="逆變啟動" IsChecked="{Binding InverterActive}" IsEnabled="False" Foreground="White" Margin="0,3" />
                                    <CheckBox Content="UPS 旁路" IsChecked="{Binding UtilityBypass}" IsEnabled="False" Foreground="White" Margin="0,3" />
                                    <CheckBox Content="市電正常" IsChecked="{Binding GridNormal}" IsEnabled="False" Foreground="White" Margin="0,3" />
                                    <CheckBox Content="綠能節能" IsChecked="{Binding SavingMode}" IsEnabled="False" Foreground="White" Margin="0,3" />
                                    <CheckBox Content="故障異常" IsChecked="{Binding Fault}" IsEnabled="False" Foreground="{StaticResource AccentRed}" Margin="0,3" />
                                    <CheckBox Content="EEPROM" IsChecked="{Binding EepromError}" IsEnabled="False" Foreground="White" Margin="0,3" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 60 秒即時趨勢折線圖 -->
                    <Border Style="{StaticResource IndustrialCard}" Height="230" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="📈 60 秒即時遙測趨勢圖 (電池電壓 V 與 負載瓦數 W)" FontWeight="SemiBold" FontSize="13" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Rectangle Width="10" Height="4" Fill="{StaticResource AccentGreen}" Margin="0,0,4,0" />
                                    <TextBlock Text="電池電壓 (V)" FontSize="11" Margin="0,0,14,0" />
                                    <Rectangle Width="10" Height="4" Fill="{StaticResource AccentCyan}" Margin="0,0,4,0" />
                                    <TextBlock Text="負載瓦數 (W)" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                            <Canvas x:Name="TrendCanvas" Grid.Row="1" Background="#0A0E18" SizeChanged="TrendCanvas_SizeChanged" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== 視圖 B：工程應用模式 (Engineering / Pro Mode) ==================== -->
                <StackPanel Visibility="{Binding IsEngineeringMode, Converter={StaticResource BoolToVis}}">
                    <!-- 核心操作控制卡片 -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="🛠️ 逆變器核心指令操作 (具備二次確認安全互鎖機制)" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentAmber}" />
                                <Border DockPanel.Dock="Right" Background="#0F172A" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                    <TextBlock Text="🔒 互鎖保護中" Foreground="{StaticResource AccentAmber}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>

                            <!-- 控制項目網格 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- 控制項 1: 交流輸出開關 -->
                                <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="交流電源輸出 (AC Output)" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="遠端啟動或切斷 110V 輸出 (`C 1`/`C 0`)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="啟動逆變輸出 (C 1)" Click="BtnTurnOnAC_Click" Background="{StaticResource AccentGreen}" Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />
                                            <Button Content="切斷輸出 (C 0)" Click="BtnTurnOffAC_Click" Background="{StaticResource AccentRed}" Style="{StaticResource IndustrialButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 控制項 2: 綠能節能模式 -->
                                <Border Grid.Column="1" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="綠能節能模式 (Saving Mode)" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="負載小於 10W 時進入 1.5W 待機 (`W 1`/`W 0`)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="啟用節能 (W 1)" Click="BtnEnableSaving_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />
                                            <Button Content="停用節能 (W 0)" Click="BtnDisableSaving_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 控制項 3: 參數解鎖 -->
                                <Border Grid.Column="2" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="參數解鎖 (Parameter Unlock)" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="寫入輸出電壓/頻率前必須發送 (`pU`)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,12" />
                                        <Button Content="發送 pU 參數解鎖" Click="BtnUnlock_Click" Background="{StaticResource AccentAmber}" Style="{StaticResource IndustrialButton}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 輸出電壓/頻率配置與設備資訊 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 電壓頻率工程配置 (自動 pU 解鎖) -->
                        <Border Grid.Column="0" Style="{StaticResource IndustrialCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="⚙️ 輸出電壓 / 頻率配置 (Voltage &amp; Frequency Setting)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock Text="原廠指令語法: V [WWW] [OFF]（系統會自動先發送 pU 解鎖後配置）" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10" />

                                <WrapPanel>
                                    <Button Content="設為 110V / 60Hz" Click="BtnSet110V60Hz_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                    <Button Content="設為 115V / 60Hz" Click="BtnSet115V60Hz_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                    <Button Content="設為 120V / 60Hz" Click="BtnSet120V60Hz_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                    <Button Content="設為 110V / 50Hz" Click="BtnSet110V50Hz_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 設備資訊查詢 -->
                        <Border Grid.Column="1" Style="{StaticResource IndustrialCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="ℹ️ 設備資訊查詢 (Device Info `I\r`)" FontWeight="Bold" FontSize="13" />
                                    <Button DockPanel.Dock="Right" Content="查詢設備資訊 (I)" Click="BtnQueryInfo_Click" Background="#1E293B" Style="{StaticResource IndustrialButton}" Padding="10,4" />
                                </DockPanel>
                                <Border Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DeviceInfoText}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource AccentCyan}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 自訂指令發送終端機 -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💻 原始指令直發控制台 (Raw Command Interactive Console)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Text="可手動輸入任何明緯遠端指令 (如 `Q`, `I`, `pU`, `C 1`, `W 0`, `V 110 060`)，指令將自動附加 `\r` 結束字元發送。" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomCmd" Text="{Binding RawCommandInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.5"
                                         FontSize="14" FontFamily="Consolas" FontWeight="Bold" Padding="10,8" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Content="發送指令 (Send)" Click="BtnSendCustomCmd_Click" Background="{StaticResource AccentCyan}" Style="{StaticResource IndustrialButton}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 4. 即時通訊封包終端監視器 (全域底部可折疊) -->
            <Expander Grid.Row="3" Header="📟 即時 ASCII 通訊封包監視器 (Raw Packet Monitor)" Foreground="{StaticResource TextMuted}" IsExpanded="True" Margin="0,10,0,0">
                <Border Background="#090D16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding TxLine, StringFormat='最後發送 (TX): {0}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="{Binding RxLine, StringFormat='最後接收 (RX): {0}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Text="{Binding ActiveDeviceName, StringFormat='連線設備: {0}'}" FontFamily="Consolas" Foreground="{StaticResource TextDim}" />
                    </Grid>
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</Window>
