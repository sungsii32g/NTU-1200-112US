<Window x:Class="Ntu1200Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ntu1200Hmi.ViewModels"
        mc:Ignorable="d"
        Title="MEAN WELL NTU-1200-112US 工業級監控與工程控制中心"
        Height="960" Width="1380" MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Microsoft JhengHei, PingFang SC, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <!-- 主題色彩定義 -->
        <SolidColorBrush x:Key="CardBg" Color="#131B2E" />
        <SolidColorBrush x:Key="CardBorder" Color="#1E293B" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="TextDim" Color="#64748B" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 工業暗黑風卡片容器樣式 -->
        <Style x:Key="IndustrialCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- 扁平化按鈕樣式 -->
        <Style x:Key="IndustrialButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 現代工業膠囊分頁按鈕樣式 (徹底去除原生白圈 ⚪ 與雜點) -->
        <Style x:Key="SegmentedTabMonitor" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedTabEngineering" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#D97706" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 暗黑高清晰 ComboBox ToggleButton 範本 (徹底解決白底看不清問題) -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="#0F172A" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.5" CornerRadius="6">
                <Border x:Name="splitBorder" Width="30" HorizontalAlignment="Right" Background="Transparent">
                    <Path x:Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource AccentCyan}" Data="M 0 0 L 4 4 L 8 0 Z" />
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="arrow" Property="Fill" Value="#38BDF8" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#0EA5E9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 全客製化深色高對比 ComboBox 樣式 -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,3,32,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#0F172A" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.5" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300" Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Popup" Property="MinHeight" Value="80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 高對比度下拉選單項目樣式 -->
        <Style x:Key="HighContrastComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162032" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0284C7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0EA5E9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 1. 頂部導航與通訊埠 -->
                <RowDefinition Height="Auto" /> <!-- 2. 雙模式分頁切換列 -->
                <RowDefinition Height="*" />    <!-- 3. 主內容視圖區 (監控 vs 工程) -->
                <RowDefinition Height="Auto" /> <!-- 4. 底部 ASCII 封包監視器 -->
            </Grid.RowDefinitions>

            <!-- 1. 頂部導航與串列埠選擇列 -->
            <Border Grid.Row="0" Style="{StaticResource IndustrialCard}" Padding="14,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌 LOGO -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCyan}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="MW" FontWeight="Bold" FontSize="14" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MEAN WELL NTU-1200-112US" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="正弦波逆變器 / UPS 工業控制中心" FontSize="11" Foreground="{StaticResource TextDim}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 串列埠控制欄位 (全新客製化深色高清晰 ComboBox) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="通訊埠 (PORT)：" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentCyan}" Margin="0,0,8,0" />
                        
                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  DisplayMemberPath="DisplayText"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource HighContrastComboItem}"
                                  Width="420" Height="36"
                                  VerticalContentAlignment="Center" Margin="0,0,10,0" />

                        <Button Content="{Binding ConnectButtonText}" 
                                Click="BtnConnect_Click"
                                Background="{StaticResource AccentCyan}"
                                Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />

                        <Button Content="⟳ 掃描" Click="BtnRefresh_Click"
                                Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                Style="{StaticResource IndustrialButton}" />
                    </StackPanel>

                    <!-- 狀態指示徽章 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="16" Padding="12,6" Margin="0,0,10,0" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <TextBlock Text="{Binding LatencyMs, StringFormat='延遲: {0} ms'}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 全系統統一：雙模式膠囊切換列 (無任何原生白圈，頂規設計) -->
            <Border Grid.Row="1" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 監控模式切換膠囊按鈕 -->
                    <RadioButton Grid.Column="0" Content="📊 即時監控模式 (Monitoring Mode)"
                                 IsChecked="{Binding IsMonitorMode, Mode=OneWay}"
                                 Click="BtnSwitchMonitor_Click"
                                 GroupName="UiMode"
                                 Style="{StaticResource SegmentedTabMonitor}" />

                    <!-- 工程應用模式切換膠囊按鈕 -->
                    <RadioButton Grid.Column="1" Content="🛠️ 工程應用模式 (Engineering / Pro Mode)"
                                 IsChecked="{Binding IsEngineeringMode, Mode=OneWay}"
                                 Click="BtnSwitchEngineering_Click"
                                 GroupName="UiMode"
                                 Style="{StaticResource SegmentedTabEngineering}" />
                </Grid>
            </Border>

            <!-- 3. 主內容區 -->
            <Grid Grid.Row="2">
                <!-- ==================== 視圖 A：即時監控模式 (Monitoring Mode) ==================== -->
                <StackPanel Visibility="{Binding IsMonitorMode, Converter={StaticResource BoolToVis}}">
                    <!-- 電力潮流即時動態拓撲 -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="⚡ 電力潮流即時動態拓撲 (Power Flow Topology)" FontWeight="SemiBold" FontSize="14" />
                                <Border DockPanel.Dock="Right" Background="#0F172A" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{Binding PowerPath}" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                </Border>
                            </DockPanel>

                            <!-- 潮流三節點視覺卡 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- 節點 1: 市電輸入 (Grid) -->
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="市電輸入 (Grid)" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding GridInputVoltage, StringFormat='{}{0:F1} V'}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4" />
                                        <TextBlock Text="AC 110V 60Hz" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 箭頭 1 -->
                                <TextBlock Grid.Column="1" Text="➔" FontSize="20" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="10,0" />

                                <!-- 節點 2: NTU-1200 逆變核心 -->
                                <Border Grid.Column="2" Background="#162032" CornerRadius="10" Padding="14" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="逆變器主核心 (NTU-1200)" FontSize="12" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Temperature, StringFormat='機溫: {0:F1} °C'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding DcBusVoltage, StringFormat='母線: {0:F0} V'}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                        </StackPanel>
                                        <TextBlock Text="1200W 純弦波逆變 / UPS 旁路" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 箭頭 2 -->
                                <TextBlock Grid.Column="3" Text="➔" FontSize="20" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="10,0" />

                                <!-- 節點 3: 負載輸出 (AC Load) -->
                                <Border Grid.Column="4" Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="交流負載 (AC Load)" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LoadWatts, StringFormat='{}{0:F0} W'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" Margin="0,4" />
                                        <TextBlock Text="{Binding LoadPercent, StringFormat='負載比率: {0} %'}" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 四大量測儀表卡片 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1: 電池直流電壓 -->
                        <Border Grid.Column="0" Style="{StaticResource IndustrialCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="電池直流電壓 (Vbat)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding BatteryVoltage, StringFormat='{}{0:F1} V'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding BatteryStatusText}" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: 交流輸出電壓 -->
                        <Border Grid.Column="1" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="交流輸出電壓 (AC Out)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding AcOutputVoltage, StringFormat='{}{0:F1} V'}" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding OutputFrequency, StringFormat='輸出頻率: {0:F1} Hz'}" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 3: 負載功率瓦數 -->
                        <Border Grid.Column="2" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="負載輸出瓦數 (Load)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding LoadWatts, StringFormat='{}{0:F0} W'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding LoadPercent, StringFormat='額定 1200W ({0}%)'}" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 4: 逆變器內部溫度 -->
                        <Border Grid.Column="3" Style="{StaticResource IndustrialCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="機內散熱器溫度 (Temp)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F1} °C'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,6,0,2" />
                                <TextBlock Text="正常範圍 (&lt; 65 °C)" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 60 秒即時動態折線圖 -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="180" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📈 60 秒即時電力與負載動態趨勢圖" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Border Background="{StaticResource AccentGreen}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="電池電壓 (V)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,14,0" />
                                    <Border Background="{StaticResource AccentCyan}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="負載瓦數 (W)" FontSize="11" Foreground="{StaticResource TextDim}" />
                                </StackPanel>
                            </DockPanel>

                            <Canvas x:Name="TrendCanvas" Grid.Row="1" Background="#0A0E18" SizeChanged="TrendCanvas_SizeChanged" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== 視圖 B：工程應用模式 (Engineering / Pro Mode - 全功能完全介面化) ==================== -->
                <StackPanel Visibility="{Binding IsEngineeringMode, Converter={StaticResource BoolToVis}}">
                    
                    <!-- 1. 核心電源開關、節能休眠與參數解鎖 (防呆確認機制) -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="⚡ 逆變器電源開關與綠能待機控制 (具備安全防呆互鎖)" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentAmber}" />
                                <Border DockPanel.Dock="Right" Background="#0F172A" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1" CornerRadius="8" Padding="10,3">
                                    <TextBlock Text="🔒 二次防呆保護已生效" Foreground="{StaticResource AccentAmber}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>

                            <!-- 控制卡片橫排 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- 控制項 1: 交流輸出電源開關 -->
                                <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="交流電源輸出 (AC Output Control)" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="遠端啟動逆變輸出 (`C 1`) 或緊急切斷 110V 輸出 (`C 0`)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⚡ 開啟 110V 輸出 (C 1)" Click="BtnTurnOnAC_Click" Background="{StaticResource AccentGreen}" Style="{StaticResource IndustrialButton}" Margin="0,0,10,0" />
                                            <Button Content="🛑 切斷 110V 輸出 (C 0)" Click="BtnTurnOffAC_Click" Background="{StaticResource AccentRed}" Style="{StaticResource IndustrialButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 控制項 2: 綠能節能模式開關 -->
                                <Border Grid.Column="1" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="綠能節能待機 (Power Saving Mode)" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="負載小於 10W 時進入 1.5W 超低待機 (`W 1`/`W 0`)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🌿 啟用節能 (W 1)" Click="BtnEnableSaving_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />
                                            <Button Content="停用節能 (W 0)" Click="BtnDisableSaving_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 控制項 3: 參數解鎖防寫開關 -->
                                <Border Grid.Column="2" Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="參數解鎖 (Parameter Unlock)" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="寫入電壓頻率前必須發送解除防寫 (`pU`)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,12" />
                                        <Button Content="🔓 發送 pU 參數解鎖" Click="BtnUnlock_Click" Background="{StaticResource AccentAmber}" Style="{StaticResource IndustrialButton}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. 輸出電壓與頻率校正矩陣 (全介面化按鈕與下拉自選，徹底擺脫手冊) -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="⚙️ 交流輸出電壓與頻率配置 (Voltage &amp; Frequency Matrix)" FontWeight="Bold" FontSize="14" Foreground="White" />
                                <TextBlock DockPanel.Dock="Right" Text="點擊任意配置將自動依序執行: 解鎖 pU ➔ 發送 V 指令 ➔ Q 回讀驗證" FontSize="11" Foreground="{StaticResource AccentCyan}" />
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- 快速預設組合按鈕 -->
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="常用國家標準快速切換 (一鍵自動解鎖與寫入)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <Button Content="110V / 60Hz (台美預設標準)" Click="BtnSet110V60Hz_Click" Background="#0284C7" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                            <Button Content="120V / 60Hz (北美高壓標準)" Click="BtnSet120V60Hz_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                            <Button Content="100V / 50Hz (日規東部 50Hz)" Click="BtnSet110V50Hz_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                            <Button Content="115V / 60Hz (美加微調)" Click="BtnSet115V60Hz_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 自選電壓與頻率組合 -->
                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="10" Padding="14" Margin="8,0,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="自訂電壓與頻率組合" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="電壓 (V)：" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding VoltageOptions}" SelectedItem="{Binding SelectedVoltage}"
                                                          Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource HighContrastComboItem}" Height="34" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="頻率 (Hz)：" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding FreqOptions}" SelectedItem="{Binding SelectedFreq}"
                                                          Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource HighContrastComboItem}" Height="34" />
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="套用自訂電壓頻率 (Apply V)" Click="BtnApplyVoltage_Click" Background="{StaticResource AccentCyan}" Style="{StaticResource IndustrialButton}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 原廠硬體規格與身分識別卡片 (Device Info & Hardware Identification) -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左側: 明緯 NTU-1200-112US 額定規格表 -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="📋 原廠型號與規格認證 (MEAN WELL NTU-1200-112US)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="連續額定功率：" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,6,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="1200W (持續滿載)" FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,2,14,2" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="峰值湧浪容量：" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,6,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="2000W (10秒支援)" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" FontSize="12" Margin="0,2,0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="直流輸入規格：" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,6,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="12Vdc (10.0~16.5V)" FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,2,14,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="交流輸出電壓：" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,6,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="110Vac 60Hz 純弦波" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" FontSize="12" Margin="0,2,0,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="UPS 切換時間：" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,6,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="&lt; 10 ms (無縫切換)" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="12" Margin="0,2,14,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="波形總諧波失真：" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,6,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="THD &lt; 3% (純淨純正弦)" FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,2,0,2" />
                                </Grid>
                            </StackPanel>

                            <!-- 右側: 設備資訊讀取 (I) -->
                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="🔍 逆變器硬體版本查詢 (`I\r`)" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <Button DockPanel.Dock="Right" Content="查詢 (I)" Click="BtnQueryInfo_Click" Background="{StaticResource AccentCyan}" Style="{StaticResource IndustrialButton}" Padding="12,4" />
                                    </DockPanel>
                                    <Border Background="#162032" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DeviceInfoText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 4. 19-Bit 狀態旗標與硬體診斷指示燈矩陣 (Diagnostic LED Matrix) -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="💡 19-Bit 硬體狀態與保護診斷矩陣 (逐位元即時監測)" FontWeight="Bold" FontSize="14" Foreground="White" />
                                <TextBlock DockPanel.Dock="Right" Text="即時位元流: 綠燈=運作中 / 紅燈=異常警報 / 暗灰=閒置" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding DiagnosticBits}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding BadgeColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding BitLabel}" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="White" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 5. 常用原廠指令快捷操作台 (Quick Command Palette - 使用者免翻手冊) -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="🚀 常用快捷指令群 (Command Palette - 點擊直接發送執行)" FontWeight="Bold" FontSize="14" Foreground="White" />
                                <TextBlock DockPanel.Dock="Right" Text="整合常用維護與診斷命令，自動附加 \r 結束字元" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </DockPanel>

                            <WrapPanel>
                                <Button Content="[Q] 讀取即時遙測" Tag="Q\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[I] 讀取設備規格" Tag="I\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[pU] 解鎖參數防寫" Tag="pU\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[C 1] 啟動逆變輸出" Tag="C 1\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[C 0] 關閉逆變輸出" Tag="C 0\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[W 1] 啟用節能待機" Tag="W 1\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[W 0] 停用節能待機" Tag="W 0\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[V 110 060] 設為 110V 60Hz" Tag="V 110 060\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[V 120 060] 設為 120V 60Hz" Tag="V 120 060\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                                <Button Content="[V 100 050] 設為 100V 50Hz" Tag="V 100 050\r" Click="BtnQuickCmd_Click" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource IndustrialButton}" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 6. 原始 ASCII 指令互動終端機 (Advanced Raw Console) -->
                    <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💻 原始底層指令直發控制台 (Raw ASCII Interactive Terminal)" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,6" />
                            <TextBlock Text="可手動輸入任何特殊或保留命令，軟體將自動補全 \r 結束符號並送出。" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomCmd" Text="{Binding RawCommandInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#0F172A" Foreground="#FFFFFF" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.5"
                                         FontSize="14" FontFamily="Consolas" FontWeight="Bold" Padding="12,8" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Content="發送指令 (Send)" Click="BtnSendCustomCmd_Click" Background="{StaticResource AccentCyan}" Style="{StaticResource IndustrialButton}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 4. 即時通訊封包終端監視器 (全域底部可折疊) -->
            <Expander Grid.Row="3" Header="📟 即時 ASCII 通訊封包監視器 (Raw Packet Monitor)" Foreground="{StaticResource TextMuted}" IsExpanded="True" Margin="0,10,0,0">
                <Border Background="#090D16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding TxLine, StringFormat='最後發送 (TX): {0}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="{Binding RxLine, StringFormat='最後接收 (RX): {0}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Text="{Binding ActiveDeviceName, StringFormat='連線設備狀態: {0}'}" FontFamily="Consolas" Foreground="{StaticResource TextDim}" />
                    </Grid>
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</Window>
