<Application x:Class="Ntu1200Hmi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 全域暗色系工業風主題筆刷 -->
        <SolidColorBrush x:Key="BgPrimary" Color="#090D16" />
        <SolidColorBrush x:Key="BgSecondary" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBg" Color="#162032" />
        <SolidColorBrush x:Key="CardBorder" Color="#22324A" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextDim" Color="#64748B" />
    </Application.Resources>
</Application>
